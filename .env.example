# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env
# Next.js автоматически читает .env. Сам .env лежит в .gitignore — не коммить секреты.

# ──────────────────────────────────────────────
# Supabase
# Project Settings → API
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Только на сервере. Никогда не коммить и не отдавай в браузер.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ──────────────────────────────────────────────
# Telegram
# Токен бота от @BotFather — нужен для проверки initData
# и парсинга каналов (getChat / getChatMemberCount / getFile).
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token

# Telegram username администратора (без @), который может добавлять каналы.
ADMIN_USERNAME=imnotsheikh
